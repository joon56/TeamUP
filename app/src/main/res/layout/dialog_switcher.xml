<?xml version="1.0" encoding="utf-8"?>
<!-- 상단 바 왼쪽을 누르면 위에서 내려오는 전환 시트: 전체 홈 / 진행 중 프로젝트 / 끝난 프로젝트 / 만들기·참여 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_top_sheet"
    android:orientation="vertical"
    android:paddingBottom="@dimen/gap_l">

    <!-- 내 프로필 한 줄 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/gap_l"
        android:paddingEnd="@dimen/gap_s"
        android:paddingBottom="@dimen/gap_m">

        <TextView
            android:id="@+id/avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Modo.BodyStrong" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Modo.BodyStrong" />

            <TextView
                android:id="@+id/handle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Modo.Caption" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/close"
            style="@style/Widget.Modo.IconButton"
            android:contentDescription="@string/action_close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <View style="@style/Widget.Modo.Divider" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:defaultFocusHighlightEnabled="false">

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gap_m"
            android:paddingTop="@dimen/gap_s"
            android:paddingEnd="@dimen/gap_m" />
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/gap_m"
        android:paddingEnd="@dimen/screen_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/newProject"
            style="@style/Widget.Modo.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/gap_s"
            android:layout_weight="1"
            android:text="@string/switcher_new_project"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/join"
            style="@style/Widget.Modo.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_join_code"
            app:icon="@drawable/ic_code"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
