<?xml version="1.0" encoding="utf-8"?>
<!-- 주차별 진행률 한 줄 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/gap_s"
    android:paddingBottom="@dimen/gap_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TeamUp.BodyStrong" />

        <TextView
            android:id="@+id/currentBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_s"
            android:background="@drawable/bg_badge"
            android:backgroundTint="@color/primary_container"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@string/week_current"
            android:textAppearance="@style/TextAppearance.TeamUp.Small"
            android:textColor="@color/on_primary_container"
            android:visibility="gone" />

        <TextView
            android:id="@+id/range"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_s"
            android:layout_weight="1"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.TeamUp.Small" />

        <TextView
            android:id="@+id/rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        style="@style/Widget.TeamUp.Progress.Linear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100" />
</LinearLayout>