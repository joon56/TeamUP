<?xml version="1.0" encoding="utf-8"?>
<!-- 시안 2 "진행률 중심" 프로젝트 개요: 진행률 링 → 팀원별 진행률 → 최근 활동 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/gap_l"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/gap_xl">

        <!-- 진행률 히어로: 링(FrameLayout으로 숫자 겹치기) + 전체·남은 업무·다음 회의 -->
        <LinearLayout
            style="@style/Widget.Modo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="@null"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/gap_l">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/ring"
                    style="@style/Widget.Modo.Progress.Circular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:max="100"
                    app:indicatorSize="112dp"
                    app:trackThickness="10dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ringRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Modo.Number"
                        tools:text="75%" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/progress_hero_week"
                        android:textAppearance="@style/TextAppearance.Modo.Small" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_l"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/overallText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Modo.BodyStrong"
                    tools:text="전체 62%" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/overallBar"
                    style="@style/Widget.Modo.Progress.Linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:max="100" />

                <TextView
                    android:id="@+id/remainingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:textAppearance="@style/TextAppearance.Modo.Caption"
                    tools:text="남은 업무 5개" />

                <TextView
                    android:id="@+id/meetingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Modo.Caption"
                    tools:text="다음 회의 화 19:00" />

                <TextView
                    android:id="@+id/weekText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Modo.Small"
                    tools:text="3주차 · 11.9 ~ 11.15" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xl"
            android:text="@string/progress_members"
            android:textAppearance="@style/TextAppearance.Modo.Section" />

        <LinearLayout
            android:id="@+id/memberList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_s"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xl"
            android:text="@string/progress_activity"
            android:textAppearance="@style/TextAppearance.Modo.Section" />

        <LinearLayout
            android:id="@+id/activityList"
            style="@style/Widget.Modo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_s"
            android:foreground="@null"
            android:orientation="vertical"
            android:paddingTop="@dimen/gap_xs"
            android:paddingBottom="@dimen/gap_xs" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
