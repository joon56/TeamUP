<?xml version="1.0" encoding="utf-8"?>
<!-- 전환 시트의 한 줄 (전체 홈 또는 프로젝트) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_switcher"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/gap_s"
    android:paddingTop="@dimen/gap_s"
    android:paddingEnd="@dimen/gap_m"
    android:paddingBottom="@dimen/gap_s">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_box"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:src="@drawable/ic_folder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Modo.BodyStrong" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Modo.Small" />
    </LinearLayout>

    <TextView
        android:id="@+id/unread"
        style="@style/Widget.Modo.Pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_s"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="@dimen/gap_s"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone"
        app:tint="@color/primary" />
</LinearLayout>
