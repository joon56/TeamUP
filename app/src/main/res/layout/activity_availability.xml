<?xml version="1.0" encoding="utf-8"?>
<!-- 가능 시간 입력: 설명 · 빠른 입력 칩 · 격자(화면 높이에 맞춤) · 요약 + 저장 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <TextView
        android:id="@+id/help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:text="@string/avail_help"
        android:textAppearance="@style/TextAppearance.Modo.Caption" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_m"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/presetEvenings"
                style="@style/Widget.Modo.ChipRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/avail_preset_evenings" />

            <TextView
                android:id="@+id/presetDefault"
                style="@style/Widget.Modo.ChipRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_s"
                android:text="@string/avail_preset_default"
                android:visibility="gone" />

            <TextView
                android:id="@+id/presetClear"
                style="@style/Widget.Modo.ChipRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_s"
                android:text="@string/avail_preset_clear" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 화면이 넉넉하면 격자가 늘어나 채우고, 좁으면(가로 화면) 스크롤. 스크롤은 왼쪽 시각 줄을 끌어서 -->
    <ScrollView
        android:id="@+id/gridScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gap_s"
        android:layout_weight="1"
        android:fillViewport="true">

        <com.modo.app.ui.meeting.AvailabilityGridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/avail_grid_desc"
            android:paddingStart="@dimen/gap_s"
            android:paddingEnd="@dimen/gap_l"
            android:paddingBottom="@dimen/gap_s" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/gap_s"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/gap_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Modo.BodyStrong" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/applyAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/avail_apply_all"
                android:textAppearance="@style/TextAppearance.Modo.Small"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            style="@style/Widget.Modo.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xs"
            android:text="@string/action_save" />
    </LinearLayout>
</LinearLayout>
