<?xml version="1.0" encoding="utf-8"?>
<!-- 시안 1 "오늘 중심" 프로젝트 개요: 오늘 내 할 일(체크) → 임박한 마감 → 이번 주 진행률 · 다음 회의 → 고정 공지 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/gap_l"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/gap_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/overview_today_title"
                android:textAppearance="@style/TextAppearance.Modo.Section" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addTask"
                style="@style/Widget.Modo.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="40dp"
                android:text="@string/board_add"
                app:icon="@drawable/ic_add" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/todayList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_s"
            android:orientation="vertical" />

        <!-- 이번 주 진행률 · 다음 회의 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/weekCard"
                style="@style/Widget.Modo.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:foreground="@null"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_this_week"
                    android:textAppearance="@style/TextAppearance.Modo.Label" />

                <TextView
                    android:id="@+id/weekRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:textAppearance="@style/TextAppearance.Modo.Number"
                    tools:text="75%" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/weekProgress"
                    style="@style/Widget.Modo.Progress.Linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:max="100" />

                <TextView
                    android:id="@+id/weekRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:textAppearance="@style/TextAppearance.Modo.Small"
                    tools:text="3주차 · 11.9 ~ 11.15" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/meetingCard"
                style="@style/Widget.Modo.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/overview_next_meeting"
                    android:textAppearance="@style/TextAppearance.Modo.Label" />

                <TextView
                    android:id="@+id/meetingWhen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:textAppearance="@style/TextAppearance.Modo.Title"
                    tools:text="오늘 19:00" />

                <TextView
                    android:id="@+id/meetingSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:textAppearance="@style/TextAppearance.Modo.Small"
                    tools:text="매주 수 19:00 · 60분" />
            </LinearLayout>
        </LinearLayout>

        <!-- 임박한 마감 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xl"
            android:text="@string/overview_due_soon"
            android:textAppearance="@style/TextAppearance.Modo.Section" />

        <LinearLayout
            android:id="@+id/dueSoonCard"
            style="@style/Widget.Modo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_s"
            android:foreground="@null"
            android:orientation="vertical"
            android:paddingTop="@dimen/gap_s"
            android:paddingBottom="@dimen/gap_s" />

        <!-- 고정 공지 -->
        <LinearLayout
            android:id="@+id/pinnedCard"
            style="@style/Widget.Modo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pin_filled"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/overview_pinned"
                    android:textAppearance="@style/TextAppearance.Modo.Label"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/pinnedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_s"
                android:textAppearance="@style/TextAppearance.Modo.BodyStrong" />

            <TextView
                android:id="@+id/pinnedBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Modo.Caption" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
