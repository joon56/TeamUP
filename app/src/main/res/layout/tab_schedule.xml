<?xml version="1.0" encoding="utf-8"?>
<!-- 일정 탭: 지연 / 오늘 / 다가오는 7일 / 이후 로 묶은 타임라인 (항목은 코드에서 추가) -->
<androidx.core.widget.NestedScrollView android:defaultFocusHighlightEnabled="false" xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scheduleScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/gap_s"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/gap_xl">

        <TextView
            android:id="@+id/scheduleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target"
            android:text="@string/schedule_title"
            android:textAppearance="@style/TextAppearance.TeamUp.Title" />

        <LinearLayout
            android:id="@+id/scheduleList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
