<?xml version="1.0" encoding="utf-8"?>
<!-- 회의 시간 찾기: 입력 현황 · 회의 길이 · 추천 TOP 3 · 히트맵 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/gap_xl">

            <!-- ===== 입력 현황 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginEnd="@dimen/screen_padding"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingTop="@dimen/card_padding"
                android:paddingBottom="@dimen/card_padding">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:textAppearance="@style/TextAppearance.Modo.BodyStrong" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_xs"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:text="@string/finder_status_hint"
                    android:textAppearance="@style/TextAppearance.Modo.Caption" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/memberChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/myButton"
                        style="@style/Widget.Modo.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/finder_edit_mine" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/requestButton"
                        style="@style/Widget.Modo.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/gap_s"
                        android:layout_weight="1"
                        android:text="@string/finder_request" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 회의 길이 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xl"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:text="@string/finder_length"
                android:textAppearance="@style/TextAppearance.Modo.Section" />

            <RadioGroup
                android:id="@+id/durationGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_s"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding" />

            <!-- ===== 추천 TOP 3 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xl"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:text="@string/finder_recommend"
                android:textAppearance="@style/TextAppearance.Modo.Section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xs"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:text="@string/finder_recommend_help"
                android:textAppearance="@style/TextAppearance.Modo.Caption" />

            <LinearLayout
                android:id="@+id/recList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/gap_s"
                android:layout_marginEnd="@dimen/screen_padding"
                android:background="@drawable/bg_card_dashed"
                android:gravity="center"
                android:padding="@dimen/gap_xl"
                android:text="@string/finder_empty"
                android:textAppearance="@style/TextAppearance.Modo.BodySecondary"
                android:visibility="gone" />

            <!-- ===== 히트맵 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xl"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/finder_heatmap"
                    android:textAppearance="@style/TextAppearance.Modo.Section" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/finder_legend_few"
                    android:textAppearance="@style/TextAppearance.Modo.Small" />

                <LinearLayout
                    android:id="@+id/legend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_xs"
                    android:layout_marginEnd="@dimen/gap_xs"
                    android:orientation="horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/finder_legend_many"
                    android:textAppearance="@style/TextAppearance.Modo.Small" />
            </LinearLayout>

            <TextView
                android:id="@+id/cellInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/gap_s"
                android:layout_marginEnd="@dimen/screen_padding"
                android:background="@drawable/bg_card_high"
                android:minHeight="48dp"
                android:paddingStart="@dimen/card_padding"
                android:paddingTop="@dimen/gap_m"
                android:paddingEnd="@dimen/card_padding"
                android:paddingBottom="@dimen/gap_m"
                android:text="@string/finder_cell_hint"
                android:textAppearance="@style/TextAppearance.Modo.BodySecondary" />

            <com.modo.app.ui.meeting.AvailabilityGridView
                android:id="@+id/heatGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_s"
                android:contentDescription="@string/avail_grid_desc"
                android:paddingStart="@dimen/gap_s"
                android:paddingEnd="@dimen/gap_l" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
