<?xml version="1.0" encoding="utf-8"?>
<!-- 설정 탭: 내 정보 · 테마 · 언어 · 시연 · 로그아웃 · 앱 정보 -->
<androidx.core.widget.NestedScrollView android:defaultFocusHighlightEnabled="false" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/gap_s"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/gap_xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:gravity="center_vertical"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.TeamUp.Title" />

        <!-- ===== 내 정보 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            android:layout_marginBottom="@dimen/gap_s"
            android:text="@string/settings_profile"
            android:textAppearance="@style/TextAppearance.TeamUp.Small" />

        <LinearLayout
            android:id="@+id/profileCard"
            style="@style/Widget.TeamUp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="@null"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="@dimen/gap_xs">

            <!-- 이니셜 아바타: 원 이미지 위에 글자를 겹쳐 표시 (FrameLayout) -->
            <FrameLayout
                android:layout_width="@dimen/avatar_l"
                android:layout_height="@dimen/avatar_l">

                <ImageView
                    android:id="@+id/avatarBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/bg_circle" />

                <TextView
                    android:id="@+id/avatarInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.TeamUp.Title" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.TeamUp.BodyStrong"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/changeName"
                style="@style/Widget.TeamUp.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_change" />
        </LinearLayout>

        <!-- ===== 테마 (RadioGroup) ===== -->
        <LinearLayout
            style="@style/Widget.TeamUp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:foreground="@null"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_dark_mode"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_s"
                    android:text="@string/settings_theme"
                    android:textAppearance="@style/TextAppearance.TeamUp.BodyStrong" />
            </LinearLayout>

            <!-- 상태는 Prefs가 기준이라 화면 상태 저장은 끔(saveEnabled=false) -->
            <RadioGroup
                android:id="@+id/themeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/themeDark"
                    style="@style/Widget.TeamUp.ChipRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/gap_s"
                    android:saveEnabled="false"
                    android:text="@string/theme_dark"
                    app:buttonCompat="@null" />

                <RadioButton
                    android:id="@+id/themeLight"
                    style="@style/Widget.TeamUp.ChipRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/gap_s"
                    android:saveEnabled="false"
                    android:text="@string/theme_light"
                    app:buttonCompat="@null" />

                <RadioButton
                    android:id="@+id/themeSystem"
                    style="@style/Widget.TeamUp.ChipRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:saveEnabled="false"
                    android:text="@string/theme_system"
                    app:buttonCompat="@null" />
            </RadioGroup>
        </LinearLayout>

        <!-- ===== 언어 (RadioGroup) ===== -->
        <LinearLayout
            style="@style/Widget.TeamUp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:foreground="@null"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_language"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_s"
                    android:text="@string/settings_language"
                    android:textAppearance="@style/TextAppearance.TeamUp.BodyStrong" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/languageGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/langSystem"
                    style="@style/Widget.TeamUp.ChipRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/gap_s"
                    android:saveEnabled="false"
                    android:text="@string/lang_system"
                    app:buttonCompat="@null" />

                <RadioButton
                    android:id="@+id/langKo"
                    style="@style/Widget.TeamUp.ChipRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/gap_s"
                    android:saveEnabled="false"
                    android:text="@string/lang_ko"
                    app:buttonCompat="@null" />

                <RadioButton
                    android:id="@+id/langEn"
                    style="@style/Widget.TeamUp.ChipRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:saveEnabled="false"
                    android:text="@string/lang_en"
                    app:buttonCompat="@null" />
            </RadioGroup>
        </LinearLayout>

        <!-- ===== 시연 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xl"
            android:layout_marginBottom="@dimen/gap_s"
            android:text="@string/settings_demo"
            android:textAppearance="@style/TextAppearance.TeamUp.Small" />

        <LinearLayout
            android:id="@+id/sampleCard"
            style="@style/Widget.TeamUp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                style="@style/Widget.TeamUp.IconBox"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sample"
                    android:textAppearance="@style/TextAppearance.TeamUp.BodyStrong" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_sample_desc"
                    android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/icon_m"
                android:layout_height="@dimen/icon_m"
                android:layout_marginStart="@dimen/gap_s"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_tertiary" />
        </LinearLayout>

        <!-- ===== 로그아웃 ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/logout"
            style="@style/Widget.TeamUp.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            android:text="@string/settings_logout"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart" />

        <!-- ===== 앱 정보 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            android:layout_marginBottom="@dimen/gap_s"
            android:text="@string/settings_about"
            android:textAppearance="@style/TextAppearance.TeamUp.Small" />

        <LinearLayout
            style="@style/Widget.TeamUp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="@null"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_s"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.TeamUp.BodyStrong" />

                <TextView
                    android:id="@+id/version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_s"
                    android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_s"
                android:text="@string/about_credits"
                android:textAppearance="@style/TextAppearance.TeamUp.Small" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
