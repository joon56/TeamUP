<?xml version="1.0" encoding="utf-8"?>
<!-- 알림 한 줄 (초대면 아래에 수락·거절 버튼) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Modo.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_s"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_box"
            android:importantForAccessibility="no"
            android:padding="9dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Modo.BodyStrong"
                tools:text="유진님이 '데이터분석 팀플'에 초대했어요" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Modo.Caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_s"
            android:textAppearance="@style/TextAppearance.Modo.Small" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_m"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/decline"
            style="@style/Widget.Modo.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="@dimen/gap_s"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:text="@string/notif_decline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/accept"
            style="@style/Widget.Modo.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:text="@string/notif_accept" />
    </LinearLayout>
</LinearLayout>
