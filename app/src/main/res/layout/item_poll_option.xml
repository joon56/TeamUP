<?xml version="1.0" encoding="utf-8"?>
<!-- 투표 선택지: 선택 표시 · 글 · 표 수 · 비율 막대 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_s"
    android:background="@drawable/bg_card_high"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="@dimen/gap_m"
    android:paddingTop="@dimen/gap_s"
    android:paddingEnd="@dimen/gap_m"
    android:paddingBottom="@dimen/gap_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mark"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_s"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Modo.Body"
            tools:text="화요일 19시" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Modo.Label"
            tools:text="3표" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/bar"
        style="@style/Widget.Modo.Progress.Linear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100" />
</LinearLayout>
