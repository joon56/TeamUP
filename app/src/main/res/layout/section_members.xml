<?xml version="1.0" encoding="utf-8"?>
<!-- 팀원: 목록(팀장·태그·진행률) → 보낸 초대 → 초대 코드 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/gap_l"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/gap_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/memberCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Modo.Section"
                tools:text="팀원 4명" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/invite"
                style="@style/Widget.Modo.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:text="@string/members_invite"
                app:icon="@drawable/ic_person_add"
                app:iconSize="18dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/memberList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/pendingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            android:text="@string/members_pending"
            android:textAppearance="@style/TextAppearance.Modo.Section"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/pendingList"
            style="@style/Widget.Modo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_s"
            android:foreground="@null"
            android:orientation="vertical"
            android:paddingTop="@dimen/gap_xs"
            android:paddingBottom="@dimen/gap_xs"
            android:visibility="gone" />

        <LinearLayout
            style="@style/Widget.Modo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xl"
            android:foreground="@null"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/invite_code"
                android:textAppearance="@style/TextAppearance.Modo.Label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.12"
                    android:textAppearance="@style/TextAppearance.Modo.Display"
                    tools:text="K7Q2MX" />

                <ImageButton
                    android:id="@+id/copyCode"
                    style="@style/Widget.Modo.IconButton"
                    android:contentDescription="@string/action_copy"
                    android:src="@drawable/ic_copy" />

                <ImageButton
                    android:id="@+id/shareCode"
                    style="@style/Widget.Modo.IconButton"
                    android:contentDescription="@string/action_share"
                    android:src="@drawable/ic_share" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/members_code_help"
                android:textAppearance="@style/TextAppearance.Modo.Small" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
