<?xml version="1.0" encoding="utf-8"?>
<!-- 시안 3 "워크스페이스" 더보기: 개요 요약 → 팀원 → 파일함·화면 모드·초대 코드·설정 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/gap_l"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/gap_xl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_overview"
            android:textAppearance="@style/TextAppearance.Modo.Section" />

        <LinearLayout
            style="@style/Widget.Modo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_s"
            android:foreground="@null"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/ring"
                    style="@style/Widget.Modo.Progress.Circular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:max="100"
                    app:indicatorSize="72dp"
                    app:trackThickness="7dp" />

                <TextView
                    android:id="@+id/ringRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textAppearance="@style/TextAppearance.Modo.BodyStrong"
                    tools:text="75%" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_l"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/summary1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Modo.BodyStrong"
                    tools:text="이번 주 진행률 · 전체 62%" />

                <TextView
                    android:id="@+id/summary2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Modo.Caption"
                    tools:text="남은 업무 5개" />

                <TextView
                    android:id="@+id/summary3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Modo.Caption"
                    tools:text="다음 회의 화 19:00" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/memberCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Modo.Section" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/invite"
                style="@style/Widget.Modo.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="40dp"
                android:text="@string/members_invite"
                app:icon="@drawable/ic_person_add" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/memberList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_s"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/menuList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingTop="@dimen/gap_xs"
            android:paddingBottom="@dimen/gap_xs" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
