<?xml version="1.0" encoding="utf-8"?>
<!-- 첨부 파일 한 줄: 종류 아이콘 · 이름 · 크기 · (빼기) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/gap_s"
    android:background="@drawable/bg_card"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/gap_m"
    android:paddingTop="@dimen/gap_s"
    android:paddingEnd="@dimen/gap_xs"
    android:paddingBottom="@dimen/gap_s">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icon_box"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_doc"
        app:tint="@color/primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Modo.Body" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Modo.Caption" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/remove"
        style="@style/Widget.Modo.IconButton.Small"
        android:contentDescription="@string/attachment_remove"
        android:src="@drawable/ic_close" />
</LinearLayout>
