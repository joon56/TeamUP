<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 프로젝트 줄 끝의 "새 프로젝트 · 코드로 참여" 카드 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="140dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="@dimen/gap_m"
    android:background="@drawable/bg_card_dashed"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:minHeight="160dp"
    android:orientation="vertical"
    android:padding="@dimen/gap_l">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_add"
        app:tint="@color/primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_s"
        android:gravity="center"
        android:text="@string/home_add_project"
        android:textAppearance="@style/TextAppearance.Modo.Label"
        android:textColor="@color/primary" />
</LinearLayout>
