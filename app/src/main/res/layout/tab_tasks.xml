<?xml version="1.0" encoding="utf-8"?>
<!--
    루트 "할 일" 탭: 모든 프로젝트의 업무를 겹치지 않는 4개 분류(할 일·진행 중·지연·완료)로 나눠 보여줌
    분류는 RadioGroup(칩 모양), 목록은 날짜별로 묶음
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/gap_xs">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tasks_title"
            android:textAppearance="@style/TextAppearance.Modo.Display" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/mineOnly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:saveEnabled="false"
            android:text="@string/filter_mine"
            android:textAppearance="@style/TextAppearance.Modo.Label" />

        <ImageButton
            android:id="@+id/search"
            style="@style/Widget.Modo.IconButton"
            android:contentDescription="@string/desc_search"
            android:src="@drawable/ic_search" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_s"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:scrollbars="none">

        <RadioGroup
            android:id="@+id/segments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/segTodo"
                style="@style/Widget.Modo.ChipRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/gap_s"
                android:saveEnabled="false"
                app:buttonCompat="@null" />

            <RadioButton
                android:id="@+id/segInProgress"
                style="@style/Widget.Modo.ChipRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/gap_s"
                android:saveEnabled="false"
                app:buttonCompat="@null" />

            <RadioButton
                android:id="@+id/segOverdue"
                style="@style/Widget.Modo.ChipRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/gap_s"
                android:saveEnabled="false"
                app:buttonCompat="@null" />

            <RadioButton
                android:id="@+id/segDone"
                style="@style/Widget.Modo.ChipRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:saveEnabled="false"
                app:buttonCompat="@null" />
        </RadioGroup>
    </HorizontalScrollView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gap_xs"
        android:layout_weight="1"
        android:defaultFocusHighlightEnabled="false">

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/gap_xl" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
