<?xml version="1.0" encoding="utf-8"?>
<!-- 업무 탭: 내 모든 프로젝트의 업무를 상태 필터(RadioGroup)와 "내 업무만"(CheckBox)으로 걸러 봄 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView android:defaultFocusHighlightEnabled="false"
        android:id="@+id/tasksScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/gap_s"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/fab_bottom_space">

            <!-- 제목 + 검색 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tasks_title"
                    android:textAppearance="@style/TextAppearance.TeamUp.Title" />

                <ImageButton
                    android:id="@+id/tasksSearch"
                    style="@style/Widget.TeamUp.IconButton"
                    android:layout_marginEnd="-12dp"
                    android:contentDescription="@string/desc_search"
                    android:src="@drawable/ic_search" />
            </LinearLayout>

            <!-- 상태 필터: RadioGroup 안의 칩 모양 RadioButton (가로 스크롤) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:overScrollMode="never"
                android:scrollbars="none">

                <RadioGroup
                    android:id="@+id/tasksFilterGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/tasksFilterAll"
                        style="@style/Widget.TeamUp.ChipRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/gap_s"
                        android:button="@null"
                        android:checked="true"
                        android:text="@string/filter_all"
                        app:buttonCompat="@null" />

                    <RadioButton
                        android:id="@+id/tasksFilterTodo"
                        style="@style/Widget.TeamUp.ChipRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/gap_s"
                        android:button="@null"
                        android:text="@string/status_todo"
                        app:buttonCompat="@null" />

                    <RadioButton
                        android:id="@+id/tasksFilterInProgress"
                        style="@style/Widget.TeamUp.ChipRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/gap_s"
                        android:button="@null"
                        android:text="@string/status_in_progress"
                        app:buttonCompat="@null" />

                    <RadioButton
                        android:id="@+id/tasksFilterDone"
                        style="@style/Widget.TeamUp.ChipRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/gap_s"
                        android:button="@null"
                        android:text="@string/status_done"
                        app:buttonCompat="@null" />

                    <RadioButton
                        android:id="@+id/tasksFilterOverdue"
                        style="@style/Widget.TeamUp.ChipRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="@null"
                        android:text="@string/status_overdue"
                        app:buttonCompat="@null" />
                </RadioGroup>
            </HorizontalScrollView>

            <!-- 내 업무만 + 개수 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/tasksMineOnly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_mine"
                    android:textAppearance="@style/TextAppearance.TeamUp.Body" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tasksCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tasksList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_s"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/tasksFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/screen_padding"
        android:contentDescription="@string/add_task"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/primary"
        app:tint="@color/on_primary" />
</FrameLayout>
