<?xml version="1.0" encoding="utf-8"?>
<!--
    루트 홈 (회의 피드백 2: 간결하게)
    인사 한 줄 → 주간 캘린더 한 줄 → 마감 임박 띠 → 진행 중 프로젝트(가로 카드) → 선택한 날 일정
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/gap_xs"
        android:paddingBottom="@dimen/gap_xl">

        <!-- ===== 인사 ===== -->
        <TextView
            android:id="@+id/greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:textAppearance="@style/TextAppearance.Modo.Display"
            tools:text="유진님, 안녕하세요" />

        <TextView
            android:id="@+id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/gap_xs"
            android:layout_marginEnd="@dimen/screen_padding"
            android:textAppearance="@style/TextAppearance.Modo.BodySecondary"
            tools:text="오늘 마감 2개 · 진행 중 3개" />

        <!-- ===== 주간 캘린더 한 줄 ===== -->
        <LinearLayout
            android:id="@+id/weekCard"
            style="@style/Widget.Modo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/gap_l"
            android:layout_marginEnd="@dimen/screen_padding"
            android:foreground="@null"
            android:orientation="vertical"
            android:paddingStart="@dimen/gap_m"
            android:paddingTop="@dimen/gap_s"
            android:paddingEnd="@dimen/gap_xs"
            android:paddingBottom="@dimen/gap_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/gap_xs">

                <TextView
                    android:id="@+id/weekLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Modo.BodyStrong"
                    tools:text="11월 2주차" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/thisWeek"
                    style="@style/Widget.Modo.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minHeight="36dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/action_this_week"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/prevWeek"
                    style="@style/Widget.Modo.IconButton.Small"
                    android:contentDescription="@string/desc_prev_week"
                    android:src="@drawable/ic_chevron_left" />

                <ImageButton
                    android:id="@+id/nextWeek"
                    style="@style/Widget.Modo.IconButton.Small"
                    android:contentDescription="@string/desc_next_week"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <com.modo.app.ui.common.WeekStripView
                android:id="@+id/weekStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xs"
                android:layout_marginEnd="@dimen/gap_s" />
        </LinearLayout>

        <!-- ===== 마감 임박 띠 ===== -->
        <LinearLayout
            android:id="@+id/attentionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/gap_m"
            android:layout_marginEnd="@dimen/screen_padding"
            android:background="@drawable/bg_attention"
            android:orientation="vertical"
            android:paddingStart="@dimen/gap_l"
            android:paddingTop="@dimen/gap_m"
            android:paddingEnd="@dimen/gap_m"
            android:paddingBottom="@dimen/gap_s"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/danger" />

                <TextView
                    android:id="@+id/attentionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Modo.BodyStrong"
                    android:textColor="@color/danger"
                    tools:text="마감 임박 3" />

                <TextView
                    android:id="@+id/attentionMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/gap_xs"
                    android:textAppearance="@style/TextAppearance.Modo.Label"
                    android:textColor="@color/danger"
                    android:visibility="gone"
                    tools:text="2개 더 보기"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/attentionList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xs"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ===== 진행 중인 프로젝트 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/gap_xl"
            android:layout_marginEnd="@dimen/screen_padding"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_projects_title"
                android:textAppearance="@style/TextAppearance.Modo.Section" />

            <TextView
                android:id="@+id/projectCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_s"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Modo.Caption"
                tools:text="4" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/projectScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/gap_s"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/projectRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 진행 중인 프로젝트가 없을 때: 만들기 · 코드로 참여 -->
        <LinearLayout
            android:id="@+id/emptyProjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/gap_m"
            android:layout_marginEnd="@dimen/screen_padding"
            android:background="@drawable/bg_card_dashed"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/gap_xl"
            android:visibility="gone">

            <ImageView
                style="@style/Widget.Modo.IconBox"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_folder"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:text="@string/home_first_title"
                android:textAppearance="@style/TextAppearance.Modo.BodyStrong" />

            <TextView
                android:id="@+id/emptyBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xs"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Modo.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_l"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/emptyNew"
                    style="@style/Widget.Modo.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/switcher_new_project" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/emptyJoin"
                    style="@style/Widget.Modo.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_s"
                    android:layout_weight="1"
                    android:text="@string/home_join_code" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 선택한 날 일정 ===== -->
        <TextView
            android:id="@+id/dayTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/gap_xl"
            android:layout_marginEnd="@dimen/screen_padding"
            android:textAppearance="@style/TextAppearance.Modo.Section"
            tools:text="오늘 · 11월 11일 (수)" />

        <LinearLayout
            android:id="@+id/dayList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/gap_m"
            android:layout_marginEnd="@dimen/screen_padding"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
