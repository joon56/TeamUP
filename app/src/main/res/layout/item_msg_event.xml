<?xml version="1.0" encoding="utf-8"?>
<!-- 날짜 구분선 / 공지·투표·업무 등록 알림 (가운데 카드) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/gap_m"
    android:layout_marginBottom="@dimen/gap_xs"
    android:gravity="center"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gap_m"
        android:paddingTop="6dp"
        android:paddingEnd="@dimen/gap_m"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Modo.Small"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
