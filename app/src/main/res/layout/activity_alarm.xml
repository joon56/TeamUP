<?xml version="1.0" encoding="utf-8"?>
<!-- 알람이 울릴 때 뜨는 화면. ConstraintLayout: 위 칩과 아래 버튼 사이에 가운데 묶음을 세로로 모아 둠(chain) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- 위 칩: MODO 알람 · 마감 3시간 전 -->
    <LinearLayout
        android:id="@+id/chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_high"
        android:backgroundTint="@color/primary_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_alarm"
            app:tint="@color/on_primary_container" />

        <TextView
            android:id="@+id/chipText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/on_primary_container"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 원 2겹 + 퍼지는 고리 + 시각 (FrameLayout으로 겹침) -->
    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gap_l"
        app:layout_constraintBottom_toTopOf="@id/title"
        app:layout_constraintDimensionRatio="W,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="@dimen/alarm_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chip"
        app:layout_constraintVertical_chainStyle="packed">

        <View
            android:id="@+id/pulse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ring_pulse" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="12dp"
            android:background="@drawable/bg_alarm_circle_outer" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="48dp"
            android:background="@drawable/bg_alarm_circle_inner" />

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:textColor="@color/text_primary"
            android:textSize="60sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_l"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stage" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/soundCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <!-- 재생 카드: 아이콘 · 소리 이름 · 재생 시간 · 막대 4개 -->
    <LinearLayout
        android:id="@+id/soundCard"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:layout_marginTop="@dimen/gap_xl"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toTopOf="@id/done"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintWidth_max="300dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_tile"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/ic_music"
            app:tint="@color/on_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/soundName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="160dp"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/soundStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 막대 4개: 아래를 기준으로 늘었다 줄었다 함 -->
        <LinearLayout
            android:id="@+id/bars"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginStart="20dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <View
                android:layout_width="3dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_eq_bar" />

            <View
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_eq_bar" />

            <View
                android:layout_width="3dp"
                android:layout_height="8dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_eq_bar" />

            <View
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_eq_bar" />
        </LinearLayout>
    </LinearLayout>

    <!-- 아래 버튼 묶음 -->
    <Button
        android:id="@+id/done"
        style="@style/Widget.Modo.Button.Raised"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_m"
        android:text="@string/alarm_action_done"
        app:icon="@drawable/ic_check"
        app:layout_constraintBottom_toTopOf="@id/snooze"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/snooze"
        style="@style/Widget.Modo.Button.Flat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="@dimen/gap_s"
        app:layout_constraintBottom_toTopOf="@id/openTask"
        app:layout_constraintEnd_toStartOf="@id/stop"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/stop"
        style="@style/Widget.Modo.Button.Flat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/alarm_action_stop"
        app:layout_constraintBottom_toBottomOf="@id/snooze"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/snooze" />

    <TextView
        android:id="@+id/openTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/gap_m"
        android:text="@string/alarm_open_task"
        android:textColor="@color/selector_link_text"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
