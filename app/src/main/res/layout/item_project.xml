<?xml version="1.0" encoding="utf-8"?>
<!-- 프로젝트 카드 (홈 "내 프로젝트") -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.TeamUp.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_s"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="@dimen/gap_xs">

    <ImageView
        android:id="@+id/icon"
        style="@style/Widget.TeamUp.IconBox"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_folder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.TeamUp.BodyStrong" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.TeamUp.Caption" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                style="@style/Widget.TeamUp.Progress.Linear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_s"
                android:layout_weight="1"
                android:max="100" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/more"
        style="@style/Widget.TeamUp.IconButton"
        android:contentDescription="@string/action_more"
        android:src="@drawable/ic_more"
        app:tint="@color/text_tertiary" />
</LinearLayout>