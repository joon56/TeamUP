<?xml version="1.0" encoding="utf-8"?>
<!-- 팀원 상세: 프로필 + 완료 현황 + 담당 업무 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <androidx.core.widget.NestedScrollView android:defaultFocusHighlightEnabled="false"
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/gap_xs"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/gap_xl">

            <!-- ===== 프로필 ===== -->
            <LinearLayout
                style="@style/Widget.TeamUp.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="@null"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/gap_xl"
                android:paddingBottom="@dimen/gap_xl">

                <!-- 동그라미 위에 이름 첫 글자를 겹쳐서 아바타로 (FrameLayout) -->
                <FrameLayout
                    android:layout_width="@dimen/avatar_l"
                    android:layout_height="@dimen/avatar_l">

                    <ImageView
                        android:id="@+id/avatarBg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/bg_circle" />

                    <TextView
                        android:id="@+id/initial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.TeamUp.Title"
                        android:textSize="26sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.TeamUp.Title" />

                <TextView
                    android:id="@+id/role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.TeamUp.BodySecondary" />

                <TextView
                    android:id="@+id/kind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:background="@drawable/bg_badge"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textAppearance="@style/TextAppearance.TeamUp.Small" />
            </LinearLayout>

            <!-- ===== 완료 현황 3칸 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Widget.TeamUp.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:foreground="@null"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/gap_m">

                    <TextView
                        android:id="@+id/statAssigned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.TeamUp.Number" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/member_stats_assigned"
                        android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.TeamUp.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:foreground="@null"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/gap_m">

                    <TextView
                        android:id="@+id/statDone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.TeamUp.Number"
                        android:textColor="@color/success" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/member_stats_done"
                        android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.TeamUp.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:foreground="@null"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/gap_m">

                    <TextView
                        android:id="@+id/statRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.TeamUp.Number"
                        android:textColor="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/member_stats_rate"
                        android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                style="@style/Widget.TeamUp.Progress.Linear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_l"
                android:max="100" />

            <!-- ===== 담당 업무 ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xl"
                android:text="@string/member_tasks"
                android:textAppearance="@style/TextAppearance.TeamUp.Section" />

            <LinearLayout
                android:id="@+id/taskList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remove"
                style="@style/Widget.TeamUp.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/gap_l"
                android:text="@string/member_remove"
                app:icon="@drawable/ic_delete" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
