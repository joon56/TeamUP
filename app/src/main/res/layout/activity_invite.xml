<?xml version="1.0" encoding="utf-8"?>
<!-- 팀원 초대: 태그·이메일로 정확히 찾기 → 프로필 확인 → 초대 / 초대 코드 / 앱 안 쓰는 팀원 추가 (회의 피드백 5) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:defaultFocusHighlightEnabled="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/gap_s"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/gap_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/invite_search_label"
                android:textAppearance="@style/TextAppearance.Modo.Section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xs"
                android:text="@string/invite_search_help"
                android:textAppearance="@style/TextAppearance.Modo.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/queryLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/invite_search_hint"
                    app:startIconDrawable="@drawable/ic_tag">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/queryInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="textEmailAddress"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/find"
                    style="@style/Widget.Modo.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="@dimen/gap_s"
                    android:layout_marginTop="3dp"
                    android:text="@string/invite_find" />
            </LinearLayout>

            <!-- 찾은 사람 -->
            <LinearLayout
                android:id="@+id/resultCard"
                style="@style/Widget.Modo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:foreground="@null"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Modo.Title"
                    tools:text="민" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/handle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Modo.BodyStrong"
                        tools:text="민수#2048" />

                    <TextView
                        android:id="@+id/school"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Modo.Caption"
                        tools:text="모프대학교" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/send"
                    style="@style/Widget.Modo.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minHeight="44dp"
                    android:text="@string/invite_send" />
            </LinearLayout>

            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_s"
                android:textAppearance="@style/TextAppearance.Modo.Caption"
                android:visibility="gone" />

            <!-- 다른 방법 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xxl"
                android:text="@string/invite_other_ways"
                android:textAppearance="@style/TextAppearance.Modo.Section" />

            <LinearLayout
                style="@style/Widget.Modo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:foreground="@null"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/invite_code"
                    android:textAppearance="@style/TextAppearance.Modo.Label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/code"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.12"
                        android:textAppearance="@style/TextAppearance.Modo.Display"
                        tools:text="K7Q2MX" />

                    <ImageButton
                        android:id="@+id/copyCode"
                        style="@style/Widget.Modo.IconButton"
                        android:contentDescription="@string/action_copy"
                        android:src="@drawable/ic_copy" />

                    <ImageButton
                        android:id="@+id/shareCode"
                        style="@style/Widget.Modo.IconButton"
                        android:contentDescription="@string/action_share"
                        android:src="@drawable/ic_share" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/members_code_help"
                    android:textAppearance="@style/TextAppearance.Modo.Small" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/guestCard"
                style="@style/Widget.Modo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_person_add"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/gap_s"
                        android:layout_weight="1"
                        android:text="@string/invite_guest_title"
                        android:textAppearance="@style/TextAppearance.Modo.BodyStrong" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_xs"
                    android:text="@string/invite_guest_body"
                    android:textAppearance="@style/TextAppearance.Modo.Small" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
