<resources>
    <!-- 앱 전체 테마. 색상은 values/colors.xml(라이트), values-night/colors.xml(다크)에서 자동 선택 -->
    <style name="Base.Theme.Modo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSecondaryContainer">@color/primary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_primary_container</item>
        <item name="colorTertiary">@color/info</item>
        <item name="colorError">@color/danger</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerLowest">@color/bg</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_highest</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline_strong</item>
        <item name="colorOutlineVariant">@color/outline</item>

        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Modo.Dialog</item>
        <!-- AlertDialog.Builder로 만드는 알림 창 -->
        <item name="alertDialogTheme">@style/ThemeOverlay.Modo.AlertDialog</item>
        <item name="android:datePickerDialogTheme">@style/ThemeOverlay.Modo.Picker</item>
        <item name="android:timePickerDialogTheme">@style/ThemeOverlay.Modo.Picker</item>
        <item name="materialButtonStyle">@style/Widget.Modo.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.Modo.Input</item>
        <item name="checkboxStyle">@style/Widget.Modo.CheckBox</item>
        <item name="radioButtonStyle">@style/Widget.Modo.Radio</item>
        <item name="bottomNavigationStyle">@style/Widget.Modo.BottomNav</item>
        <item name="snackbarStyle">@style/Widget.Modo.Snackbar</item>
        <!-- 롱프레스 메뉴·멘션 목록: 배경과 구분되는 둥근 카드 -->
        <item name="popupMenuBackground">@drawable/bg_popup</item>
        <!-- 기본(android.widget) PopupMenu·ListPopupWindow도 같은 카드 배경 -->
        <item name="android:popupMenuStyle">@style/Widget.Modo.PopupMenu</item>
        <item name="android:listPopupWindowStyle">@style/Widget.Modo.ListPopupWindow</item>
    </style>

    <style name="Theme.Modo" parent="Base.Theme.Modo" />

    <style name="Widget.Modo.PopupMenu" parent="android:Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>

    <style name="Widget.Modo.ListPopupWindow" parent="android:Widget.Material.ListPopupWindow">
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>

    <style name="ThemeOverlay.Modo.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Modo.Dialog</item>
    </style>

    <!-- AlertDialog.Builder 알림 창: 앱 카드 색 배경 + 앱 글꼴 -->
    <style name="ThemeOverlay.Modo.AlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_window</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>
    </style>

    <!-- 날짜·시간 선택창 (DatePickerDialog / TimePickerDialog).
         창 배경을 직접 지정해야 다크 모드에서 흰 바탕에 흰 글씨가 되지 않음 -->
    <style name="ThemeOverlay.Modo.Picker" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_window</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="android:datePickerStyle">@style/Widget.Modo.DatePicker</item>
        <item name="android:timePickerStyle">@style/Widget.Modo.TimePicker</item>
    </style>

    <!-- 달력 머리글: 색 띠 없이 창 배경 그대로 두고 글자색만 앱 색으로 (라이트 · 다크 모두 잘 보이게) -->
    <style name="Widget.Modo.DatePicker" parent="android:Widget.Material.DatePicker">
        <item name="android:headerBackground">@android:color/transparent</item>
        <item name="android:headerMonthTextAppearance">@style/TextAppearance.Modo.PickerHeader</item>
    </style>

    <style name="TextAppearance.Modo.PickerHeader" parent="android:TextAppearance.Material.Headline">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 시간은 시계 대신 돌리는 휠(spinner)로 (회의 피드백) -->
    <style name="Widget.Modo.TimePicker" parent="android:Widget.Material.TimePicker">
        <item name="android:timePickerMode">spinner</item>
        <item name="android:headerBackground">@color/primary</item>
    </style>

    <!-- 위에서 내려오는 전환 시트 -->
    <style name="ThemeOverlay.Modo.TopSheet" parent="Theme.Modo">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowAnimationStyle">@style/Animation.Modo.TopSheet</item>
    </style>

    <style name="Animation.Modo.TopSheet" parent="">
        <item name="android:windowEnterAnimation">@anim/slide_down_in</item>
        <item name="android:windowExitAnimation">@anim/slide_up_out</item>
    </style>

    <!-- 아래에서 올라오는 시트 화면 (알람 설정). 뒤 화면이 어둡게 비쳐 보임 -->
    <style name="Theme.Modo.Sheet" parent="Theme.Modo">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowAnimationStyle">@style/Animation.Modo.Sheet</item>
    </style>

    <style name="Animation.Modo.Sheet" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/sheet_up_in</item>
        <item name="android:activityCloseExitAnimation">@anim/sheet_down_out</item>
    </style>

    <!-- 스플래시(시작 화면): 앱이 뜨는 동안에도 앱 배경색이 보이게 -->
    <style name="Theme.Modo.Splash" parent="Theme.Modo">
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <!-- 알람 화면: 잠금 화면 위에 뜨므로 배경을 불투명하게 -->
    <style name="Theme.Modo.Alarm" parent="Theme.Modo">
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="ShapeAppearance.Modo.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>
