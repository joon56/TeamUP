<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== 글자 스타일 ===== -->
    <style name="TextAppearance.TeamUp" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.TeamUp.Display">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.TeamUp.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.TeamUp.Section">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.TeamUp.BodyStrong">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
    </style>

    <style name="TextAppearance.TeamUp.Body">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.TeamUp.BodySecondary">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.TeamUp.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.TeamUp.Small">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="fontFamily">@font/pretendard_medium</item>
    </style>

    <style name="TextAppearance.TeamUp.Number">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.TeamUp.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ===== 카드 / 컨테이너 ===== -->
    <style name="Widget.TeamUp.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:padding">@dimen/card_padding</item>
    </style>

    <style name="Widget.TeamUp.IconBox" parent="">
        <item name="android:layout_width">@dimen/icon_box</item>
        <item name="android:layout_height">@dimen/icon_box</item>
        <item name="android:background">@drawable/bg_icon_box</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Widget.TeamUp.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/text_primary</item>
    </style>

    <style name="Widget.TeamUp.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/outline</item>
    </style>

    <!-- ===== 버튼 ===== -->
    <style name="Widget.TeamUp.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="iconTint">@color/on_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.TeamUp.Button</item>
    </style>

    <style name="Widget.TeamUp.Button.Tonal" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/surface_high</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.TeamUp.Button</item>
    </style>

    <style name="Widget.TeamUp.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
        <item name="android:textAppearance">@style/TextAppearance.TeamUp.Button</item>
    </style>

    <style name="Widget.TeamUp.Button.Danger" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/danger</item>
        <item name="iconTint">@color/danger</item>
        <item name="android:textAppearance">@style/TextAppearance.TeamUp.Button</item>
    </style>

    <!-- ===== 입력 ===== -->
    <style name="Widget.TeamUp.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <!-- ===== 선택 위젯 ===== -->
    <style name="Widget.TeamUp.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/selector_check</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.TeamUp.Radio" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="buttonTint">@color/selector_check</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <!-- RadioButton을 둥근 칩 모양으로 (필터, 우선순위, 상태 선택) -->
    <style name="Widget.TeamUp.ChipRadio" parent="">
        <item name="android:button">@null</item>
        <!-- AppCompat RadioButton은 buttonCompat으로 원을 따로 그리므로 함께 지움 -->
        <item name="buttonCompat">@null</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- ===== 진행률 ===== -->
    <style name="Widget.TeamUp.Progress.Linear" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">@dimen/progress_track</item>
        <item name="trackCornerRadius">3dp</item>
        <item name="trackColor">@color/surface_highest</item>
        <item name="indicatorColor">@color/primary</item>
        <item name="indicatorTrackGapSize">0dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
    </style>

    <style name="Widget.TeamUp.Progress.Circular" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorSize">@dimen/ring_size</item>
        <item name="trackThickness">@dimen/ring_thickness</item>
        <item name="trackCornerRadius">6dp</item>
        <item name="trackColor">@color/surface_highest</item>
        <item name="indicatorColor">@color/primary</item>
        <item name="indicatorTrackGapSize">0dp</item>
    </style>

    <!-- ===== 하단 탭 ===== -->
    <style name="Widget.TeamUp.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/nav_bg</item>
        <item name="itemIconTint">@color/selector_nav_item</item>
        <item name="itemTextColor">@color/selector_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.TeamUp.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.TeamUp.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.TeamUp.NavLabel</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.TeamUp.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_container</item>
    </style>

    <style name="TextAppearance.TeamUp.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="fontFamily">@font/pretendard_medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.TeamUp.Snackbar" parent="Widget.Material3.Snackbar" />
</resources>
