<?xml version="1.0" encoding="utf-8"?>
<!--
    홈 대시보드 가로 모드 (리소스 조건: layout-land).
    세로 모드(layout/tab_home.xml)와 id·뷰 종류가 모두 같아야 ViewBinding이 그대로 동작함.
    왼쪽 열: 버튼 · 통계 · 다가오는 일정 · 최근 업무 / 오른쪽 열: 내 프로젝트
-->
<androidx.core.widget.NestedScrollView android:defaultFocusHighlightEnabled="false" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/gap_s"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/gap_xl">

        <!-- ===== 상단 바: 로고 · 검색 · 알림 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo" />

            <TextView
                android:id="@+id/appName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_s"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.TeamUp.Title" />

            <ImageButton
                android:id="@+id/search"
                style="@style/Widget.TeamUp.IconButton"
                android:contentDescription="@string/desc_search"
                android:src="@drawable/ic_search" />

            <FrameLayout
                android:id="@+id/bellBox"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_marginEnd="-12dp">

                <ImageButton
                    android:id="@+id/bell"
                    style="@style/Widget.TeamUp.IconButton"
                    android:contentDescription="@string/desc_notifications"
                    android:src="@drawable/ic_bell" />

                <!-- 알림 개수 배지: 아이콘 위에 겹쳐서 표시 -->
                <TextView
                    android:id="@+id/bellBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_notif_dot"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- ===== 인사 ===== -->
        <TextView
            android:id="@+id/greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:textAppearance="@style/TextAppearance.TeamUp.Display" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xs"
            android:text="@string/home_subtitle"
            android:textAppearance="@style/TextAppearance.TeamUp.BodySecondary" />

        <!-- ===== 2단 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- 왼쪽 열 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/gap_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/actionNew"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_primary_action"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_add"
                            app:tint="#FFFFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/home_new_project"
                            android:textAppearance="@style/TextAppearance.TeamUp.BodyStrong"
                            android:textColor="#FFFFFFFF" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionJoin"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_action"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_code" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/home_join_code"
                            android:textAppearance="@style/TextAppearance.TeamUp.BodyStrong" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 통계 2×2 (GridLayout) -->
                <GridLayout
                    android:id="@+id/stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-4dp"
                    android:layout_marginTop="@dimen/gap_m"
                    android:layout_marginEnd="-4dp"
                    android:columnCount="2"
                    android:rowCount="2">

                    <LinearLayout
                        style="@style/Widget.TeamUp.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:foreground="@null"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.TeamUp.Number" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_total"
                            android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Widget.TeamUp.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:foreground="@null"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statDone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.TeamUp.Number"
                            android:textColor="@color/success" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_done"
                            android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Widget.TeamUp.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:foreground="@null"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statInProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.TeamUp.Number"
                            android:textColor="@color/info" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_in_progress"
                            android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Widget.TeamUp.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:foreground="@null"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statOverdue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.TeamUp.Number"
                            android:textColor="@color/danger" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_overdue"
                            android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
                    </LinearLayout>
                </GridLayout>

                <!-- 다가오는 일정 -->
                <TextView
                    android:id="@+id/nextUpTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_l"
                    android:text="@string/home_next_up"
                    android:textAppearance="@style/TextAppearance.TeamUp.Section" />

                <LinearLayout
                    android:id="@+id/nextUpList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:orientation="vertical" />

                <!-- 최근 변경된 업무 -->
                <TextView
                    android:id="@+id/recentTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_l"
                    android:text="@string/home_recent"
                    android:textAppearance="@style/TextAppearance.TeamUp.Section" />

                <LinearLayout
                    android:id="@+id/recentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 오른쪽 열: 내 프로젝트 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/projectsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_my_projects"
                        android:textAppearance="@style/TextAppearance.TeamUp.Section" />

                    <TextView
                        android:id="@+id/projectsCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/gap_s"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.TeamUp.Caption" />

                    <TextView
                        android:id="@+id/filterButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:drawablePadding="2dp"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target"
                        android:paddingStart="@dimen/gap_s"
                        android:text="@string/filter_active"
                        android:textAppearance="@style/TextAppearance.TeamUp.Caption"
                        app:drawableEndCompat="@drawable/ic_expand_more"
                        app:drawableTint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/projectList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:orientation="vertical" />

                <!-- 프로젝트가 하나도 없을 때 -->
                <LinearLayout
                    android:id="@+id/emptyState"
                    style="@style/Widget.TeamUp.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="@null"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/gap_xl"
                    android:visibility="gone">

                    <ImageView
                        style="@style/Widget.TeamUp.IconBox"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_folder"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_m"
                        android:text="@string/home_empty_title"
                        android:textAppearance="@style/TextAppearance.TeamUp.BodyStrong" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_xs"
                        android:gravity="center"
                        android:text="@string/home_empty_body"
                        android:textAppearance="@style/TextAppearance.TeamUp.Caption" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sampleButton"
                        style="@style/Widget.TeamUp.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_l"
                        android:text="@string/home_empty_sample"
                        app:icon="@drawable/ic_sparkle" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
