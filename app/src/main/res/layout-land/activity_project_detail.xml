<?xml version="1.0" encoding="utf-8"?>
<!-- 프로젝트 상세 (가로 모드): 왼쪽 = 정보 카드 + 세그먼트, 오른쪽 = 선택한 내용. id·뷰 종류는 세로와 동일 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/topBar"
            layout="@layout/view_top_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.core.widget.NestedScrollView android:defaultFocusHighlightEnabled="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_padding"
                    android:paddingTop="@dimen/gap_xs"
                    android:paddingEnd="@dimen/gap_s"
                    android:paddingBottom="@dimen/gap_xl">

                <!-- ===== 프로젝트 정보 카드 ===== -->
                <LinearLayout
                    android:id="@+id/headerCard"
                    style="@style/Widget.TeamUp.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="@null"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/projectIcon"
                            style="@style/Widget.TeamUp.IconBox"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_folder" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/gap_m"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/projectName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textAppearance="@style/TextAppearance.TeamUp.Title" />

                            <TextView
                                android:id="@+id/period"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_m"
                        android:textAppearance="@style/TextAppearance.TeamUp.BodySecondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_m"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_s"
                            android:layout_height="@dimen/icon_s"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_event"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:id="@+id/meeting"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/gap_s"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
                    </LinearLayout>

                    <View
                        style="@style/Widget.TeamUp.Divider"
                        android:layout_marginTop="@dimen/gap_m" />

                    <!-- 초대 코드: 복사 / 공유 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_s"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/invite_code"
                                android:textAppearance="@style/TextAppearance.TeamUp.Small" />

                            <TextView
                                android:id="@+id/inviteCode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:letterSpacing="0.15"
                                android:textAppearance="@style/TextAppearance.TeamUp.Section"
                                android:textIsSelectable="true" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/copyCode"
                            style="@style/Widget.TeamUp.IconButton"
                            android:contentDescription="@string/action_copy"
                            android:src="@drawable/ic_copy"
                            app:tint="@color/text_secondary" />

                        <ImageButton
                            android:id="@+id/shareCode"
                            style="@style/Widget.TeamUp.IconButton"
                            android:contentDescription="@string/action_share"
                            android:src="@drawable/ic_share"
                            app:tint="@color/primary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== 세그먼트: 개요 / 업무 / 팀원 (RadioGroup) ===== -->
                <RadioGroup
                    android:id="@+id/segment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_l"
                    android:background="@drawable/bg_segment"
                    android:checkedButton="@+id/segOverview"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <RadioButton
                        android:id="@+id/segOverview"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segment_item"
                        android:button="@null"
                        android:gravity="center"
                        android:minHeight="0dp"
                        android:text="@string/tab_overview"
                        android:textAppearance="@style/TextAppearance.TeamUp.BodyStrong"
                        android:textColor="@color/selector_nav_item" />

                    <RadioButton
                        android:id="@+id/segTasks"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segment_item"
                        android:button="@null"
                        android:gravity="center"
                        android:minHeight="0dp"
                        android:text="@string/tab_tasks"
                        android:textAppearance="@style/TextAppearance.TeamUp.BodyStrong"
                        android:textColor="@color/selector_nav_item" />

                    <RadioButton
                        android:id="@+id/segMembers"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segment_item"
                        android:button="@null"
                        android:gravity="center"
                        android:minHeight="0dp"
                        android:text="@string/tab_members"
                        android:textAppearance="@style/TextAppearance.TeamUp.BodyStrong"
                        android:textColor="@color/selector_nav_item" />
                </RadioGroup>

            </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <androidx.core.widget.NestedScrollView android:defaultFocusHighlightEnabled="false"
                android:id="@+id/scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/gap_s"
                    android:paddingTop="@dimen/gap_xs"
                    android:paddingEnd="@dimen/screen_padding"
                    android:paddingBottom="@dimen/fab_bottom_space">

                <!-- 세그먼트 내용 3개를 겹쳐 두고 선택된 것만 보이게 (FrameLayout) -->
                <FrameLayout
                    android:id="@+id/segmentContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- ===== 개요 ===== -->
                    <LinearLayout
                        android:id="@+id/overviewPane"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            style="@style/Widget.TeamUp.Card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:foreground="@null"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- 원형 진행률 위에 % 글자를 겹쳐서 표시 -->
                            <FrameLayout
                                android:id="@+id/ringBox"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <com.google.android.material.progressindicator.CircularProgressIndicator
                                    android:id="@+id/weekRing"
                                    style="@style/Widget.TeamUp.Progress.Circular"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:max="100" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/weekRate"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.TeamUp.Number" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/progress_this_week"
                                        android:textAppearance="@style/TextAppearance.TeamUp.Small" />
                                </LinearLayout>
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/gap_l"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/weekLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.TeamUp.BodyStrong" />

                                <TextView
                                    android:id="@+id/weekRange"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textAppearance="@style/TextAppearance.TeamUp.Caption" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/gap_l"
                                    android:text="@string/progress_overall"
                                    android:textAppearance="@style/TextAppearance.TeamUp.Small" />

                                <com.google.android.material.progressindicator.LinearProgressIndicator
                                    android:id="@+id/overallProgress"
                                    style="@style/Widget.TeamUp.Progress.Linear"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:max="100" />

                                <TextView
                                    android:id="@+id/overallText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/gap_xs"
                                    android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap_xl"
                            android:text="@string/status_summary"
                            android:textAppearance="@style/TextAppearance.TeamUp.Section" />

                        <!-- 상태별 업무 2×2 (GridLayout) -->
                        <GridLayout
                            android:id="@+id/statusGrid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="-4dp"
                            android:layout_marginTop="@dimen/gap_s"
                            android:layout_marginEnd="-4dp"
                            android:columnCount="2"
                            android:rowCount="2">

                            <LinearLayout
                                style="@style/Widget.TeamUp.Card"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="4dp"
                                android:foreground="@null"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/statTodo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textAppearance="@style/TextAppearance.TeamUp.Number"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/status_todo"
                                    android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
                            </LinearLayout>

                            <LinearLayout
                                style="@style/Widget.TeamUp.Card"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="4dp"
                                android:foreground="@null"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/statInProgress"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textAppearance="@style/TextAppearance.TeamUp.Number"
                                    android:textColor="@color/info" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/status_in_progress"
                                    android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
                            </LinearLayout>

                            <LinearLayout
                                style="@style/Widget.TeamUp.Card"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="4dp"
                                android:foreground="@null"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/statDone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textAppearance="@style/TextAppearance.TeamUp.Number"
                                    android:textColor="@color/success" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/status_done"
                                    android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
                            </LinearLayout>

                            <LinearLayout
                                style="@style/Widget.TeamUp.Card"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="4dp"
                                android:foreground="@null"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/statOverdue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textAppearance="@style/TextAppearance.TeamUp.Number"
                                    android:textColor="@color/danger" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/status_overdue"
                                    android:textAppearance="@style/TextAppearance.TeamUp.Caption" />
                            </LinearLayout>
                        </GridLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap_xl"
                            android:text="@string/progress_weekly"
                            android:textAppearance="@style/TextAppearance.TeamUp.Section" />

                        <LinearLayout
                            android:id="@+id/weekList"
                            style="@style/Widget.TeamUp.Card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap_m"
                            android:foreground="@null"
                            android:orientation="vertical"
                            android:paddingTop="@dimen/gap_s"
                            android:paddingBottom="@dimen/gap_s" />
                    </LinearLayout>

                    <!-- ===== 업무 (주차별로 묶어서 코드에서 채움) ===== -->
                    <LinearLayout
                        android:id="@+id/tasksPane"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <!-- ===== 팀원 ===== -->
                    <LinearLayout
                        android:id="@+id/membersPane"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/members_hint"
                            android:textAppearance="@style/TextAppearance.TeamUp.Caption" />

                        <LinearLayout
                            android:id="@+id/memberList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap_m"
                            android:orientation="vertical" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addMember"
                            style="@style/Widget.TeamUp.Button.Tonal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap_s"
                            android:text="@string/add_member"
                            app:icon="@drawable/ic_person_add"
                            app:iconGravity="textStart" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/screen_padding"
        android:text="@string/add_task"
        android:textAppearance="@style/TextAppearance.TeamUp.Button"
        android:textColor="@color/on_primary"
        app:backgroundTint="@color/primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/on_primary" />
</FrameLayout>