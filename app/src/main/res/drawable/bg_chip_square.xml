<?xml version="1.0" encoding="utf-8"?>
<!-- 알람 시각 선택 칩: 고르면 보라색, 고를 수 없으면 점선 테두리로 흐리게 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg" />
            <stroke android:width="1dp" android:color="@color/outline" android:dashGap="3dp" android:dashWidth="3dp" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_highest" />
            <stroke android:width="1dp" android:color="@color/outline_strong" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_high" />
            <stroke android:width="1dp" android:color="@color/outline" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
