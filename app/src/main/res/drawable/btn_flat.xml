<?xml version="1.0" encoding="utf-8"?>
<!-- 회색 보조 버튼 (알람 화면의 다시 알림 · 끄기). 누르면 한 단계 진한 색, 포커스가 가면 보라 테두리 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_highest" />
            <stroke android:width="1dp" android:color="@color/outline_strong" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_high" />
            <stroke android:width="2dp" android:color="@color/primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_high" />
            <stroke android:width="1dp" android:color="@color/outline" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
