rules_version = '2';

// MODO Firestore 보안 규칙 (v0.2)
// - 로그인한 사용자만 접근
// - 프로젝트와 하위 데이터는 프로젝트 memberUids 에 있는 사람만 읽고 쓸 수 있음
// - 팀원이 되려면 초대 코드가 맞거나, 나에게 온 초대를 수락해야 함
// - 채팅방은 참여자만. 팀방 참여자는 항상 프로젝트 팀원과 같아야 함
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function projectDoc(pid) {
      return /databases/$(database)/documents/projects/$(pid);
    }

    function roomDoc(roomId) {
      return /databases/$(database)/documents/chatRooms/$(roomId);
    }

    // 쓰기 "전" 상태 기준 팀원인가 (읽기·수정·삭제)
    function isMember(pid) {
      return signedIn() && me() in get(projectDoc(pid)).data.memberUids;
    }

    // 쓰기 "후" 상태 기준 팀원인가 (같은 batch 에서 프로젝트를 만들거나 합류하면서 하위 문서를 쓸 때)
    function isMemberAfter(pid) {
      return signedIn() && me() in getAfter(projectDoc(pid)).data.memberUids;
    }

    function isOwner(pid) {
      return signedIn() && get(projectDoc(pid)).data.ownerUid == me();
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ───────────────────────── 사용자 ─────────────────────────

    match /users/{userId} {
      allow read, write: if signedIn() && me() == userId;
    }

    // 태그 검색 (문서 id = 이름소문자#태그). 단건 조회만, 남의 태그는 덮어쓸 수 없음
    match /userHandles/{handle} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update: if signedIn() && resource.data.uid == me() && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // 이메일 검색 (문서 id = 로그인 토큰의 이메일 소문자). 단건 조회만
    match /userEmails/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.uid == me()
        && 'email' in request.auth.token
        && request.auth.token.email.lower() == email;
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // ───────────────────────── 초대 코드 ─────────────────────────

    match /inviteCodes/{code} {
      // 코드를 정확히 알 때만 단건 조회 (목록 조회 불가)
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == me()
        && getAfter(projectDoc(request.resource.data.projectId)).data.ownerUid == me();
      allow update: if false;
      // 만든 사람 또는 지금 팀장 (팀장을 넘겨받은 경우)
      allow delete: if signedIn() && (resource.data.ownerUid == me() || isOwner(resource.data.projectId));
    }

    // ───────────────────────── 프로젝트 ─────────────────────────

    match /projects/{pid} {

      function memberAfter() {
        return getAfter(/databases/$(database)/documents/projects/$(pid)/members/$(request.auth.uid)).data;
      }

      function inviteAfter(iid) {
        return getAfter(/databases/$(database)/documents/projects/$(pid)/invites/$(iid)).data;
      }

      // 합류 근거: 같은 batch 로 만든 내 팀원 문서의 초대 코드가 맞거나, 나에게 온 초대를 수락함
      function joinAllowed() {
        let m = memberAfter();
        return (resource.data.inviteCode != '' && m.get('joinCode', '') == resource.data.inviteCode)
          || (m.get('inviteId', '') != ''
              && inviteAfter(m.inviteId).toUid == me()
              && inviteAfter(m.inviteId).status == 'ACCEPTED');
      }

      function sameMembers() {
        return request.resource.data.memberUids == resource.data.memberUids;
      }

      function onlyRemovesMembers() {
        return resource.data.memberUids.toSet().hasAll(request.resource.data.memberUids.toSet());
      }

      function onlyRemovesMe() {
        return request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().difference([me()].toSet());
      }

      allow read: if signedIn() && me() in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.ownerUid == me()
        && request.resource.data.memberUids == [me()];

      allow update: if signedIn() && (
        // 팀원: 일반 수정. 팀장·초대 코드는 그대로, 팀원 목록은 팀장의 내보내기 또는 본인 나가기만
        (me() in resource.data.memberUids
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && (sameMembers()
              || (resource.data.ownerUid == me() && onlyRemovesMembers() && me() in request.resource.data.memberUids)
              || (resource.data.ownerUid != me() && onlyRemovesMe())))
        ||
        // 팀장 넘기기: 지금 팀장이 다른 팀원에게
        (resource.data.ownerUid == me()
          && request.resource.data.ownerUid in resource.data.memberUids
          && changedOnly(['ownerUid', 'updatedAt']))
        ||
        // 합류: memberUids 에 나만 추가
        (!(me() in resource.data.memberUids)
          && changedOnly(['memberUids'])
          && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().union([me()].toSet())
          && joinAllowed())
      );

      allow delete: if signedIn() && resource.data.ownerUid == me();

      match /members/{memberId} {
        allow read: if isMember(pid);
        allow create: if isMemberAfter(pid);
        allow update: if isMember(pid);
        // 팀장(내보내기), 본인(나가기), 또는 앱을 안 쓰는 팀원(uid 없음)
        allow delete: if isMember(pid)
          && (isOwner(pid) || memberId == me() || resource.data.get('uid', null) == null);
      }

      match /tasks/{taskId} {
        allow read, update, delete: if isMember(pid);
        allow create: if isMemberAfter(pid);
      }

      match /notices/{nid} {
        allow read, update: if isMember(pid);
        allow create: if isMember(pid) && request.resource.data.authorUid == me();
        allow delete: if isMember(pid) && (resource.data.authorUid == me() || isOwner(pid));

        match /votes/{voterId} {
          allow read: if isMember(pid);
          allow write: if isMember(pid) && voterId == me();
        }
      }

      match /minutes/{mid} {
        allow read, create, update, delete: if isMember(pid);
      }

      match /files/{fid} {
        allow read: if isMember(pid);
        allow create: if isMember(pid) && request.resource.data.uploadedBy == me();
        allow delete: if isMember(pid) && (resource.data.uploadedBy == me() || isOwner(pid));
      }

      match /invites/{iid} {
        allow read: if isMember(pid) || (signedIn() && resource.data.toUid == me());
        allow create: if isMember(pid)
          && request.resource.data.fromUid == me()
          && request.resource.data.projectId == pid
          && request.resource.data.status == 'PENDING';
        allow update: if signedIn() && (
          // 받은 사람: 수락·거절
          (resource.data.toUid == me()
            && resource.data.status == 'PENDING'
            && changedOnly(['status', 'respondedAt'])
            && request.resource.data.status in ['ACCEPTED', 'DECLINED'])
          ||
          // 팀원: 보낸 초대 취소
          (isMember(pid) && changedOnly(['status']) && request.resource.data.status == 'CANCELED'));
        allow delete: if isMember(pid);
      }
    }

    // 받은 초대 목록 (컬렉션 그룹 쿼리: toUid == 나)
    match /{path=**}/invites/{iid} {
      allow read: if signedIn() && resource.data.toUid == me();
    }

    // ───────────────────────── 채팅 ─────────────────────────

    match /chatRooms/{roomId} {

      function participant() {
        return signedIn() && me() in resource.data.memberUids;
      }

      function projectMembersAfter(pid) {
        return getAfter(projectDoc(pid)).data.memberUids;
      }

      allow read: if participant();

      allow create: if signedIn() && (
        // 팀방: id = p_{프로젝트}, 참여자 = 프로젝트 팀원
        (request.resource.data.type == 'PROJECT'
          && roomId == 'p_' + request.resource.data.projectId
          && me() in projectMembersAfter(request.resource.data.projectId)
          && request.resource.data.memberUids.toSet() == projectMembersAfter(request.resource.data.projectId).toSet())
        ||
        // 1:1방: id = d_{작은uid}_{큰uid}
        (request.resource.data.type == 'DIRECT'
          && request.resource.data.memberUids.size() == 2
          && me() in request.resource.data.memberUids
          && request.resource.data.memberUids[0] < request.resource.data.memberUids[1]
          && roomId == 'd_' + request.resource.data.memberUids[0] + '_' + request.resource.data.memberUids[1])
      );

      allow update: if signedIn() && (
        // 참여자: 마지막 메시지·안 읽은 수·이름표
        (participant() && changedOnly(['lastMessage', 'updatedAt', 'unread', 'names']))
        ||
        // 팀방 참여자를 프로젝트 팀원과 맞춤 (합류·나가기·내보내기)
        (resource.data.type == 'PROJECT'
          && (participant() || me() in projectMembersAfter(resource.data.projectId))
          && changedOnly(['memberUids', 'names', 'unread', 'updatedAt'])
          && request.resource.data.memberUids.toSet() == projectMembersAfter(resource.data.projectId).toSet())
      );

      // 팀방은 프로젝트를 지울 때 팀장이 함께 지움
      allow delete: if signedIn() && resource.data.type == 'PROJECT' && isOwner(resource.data.projectId);

      match /messages/{mid} {

        function roomOwner(rid) {
          let room = get(roomDoc(rid)).data;
          return room.type == 'PROJECT' && get(projectDoc(room.projectId)).data.ownerUid == me();
        }

        allow read: if signedIn() && me() in get(roomDoc(roomId)).data.memberUids;
        allow create: if signedIn()
          && request.resource.data.senderUid == me()
          && me() in getAfter(roomDoc(roomId)).data.memberUids;
        allow update: if false;
        allow delete: if signedIn() && (resource.data.senderUid == me() || roomOwner(roomId));
      }
    }

    // 나를 멘션한 메시지 (컬렉션 그룹 쿼리: mentions array-contains 나)
    match /{path=**}/messages/{mid} {
      allow read: if signedIn() && me() in resource.data.mentions;
    }
  }
}
