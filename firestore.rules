rules_version = '2';

// TeamUp Firestore 보안 규칙
// - 로그인한 사용자만 접근
// - 프로젝트·팀원·업무는 프로젝트 memberUids 에 있는 사람만 읽고 쓸 수 있음
// - 초대 코드를 아는 사람만 자기 자신을 팀원으로 추가할 수 있음
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function projectDoc(pid) {
      return /databases/$(database)/documents/projects/$(pid);
    }

    // 쓰기 "전" 상태 기준 팀원인가 (읽기·수정·삭제)
    function isMember(pid) {
      return signedIn() && request.auth.uid in get(projectDoc(pid)).data.memberUids;
    }

    // 쓰기 "후" 상태 기준 팀원인가 (같은 batch 에서 프로젝트를 만들면서 팀원·업무를 추가할 때)
    function isMemberAfter(pid) {
      return signedIn() && request.auth.uid in getAfter(projectDoc(pid)).data.memberUids;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /inviteCodes/{code} {
      // 코드를 정확히 알 때만 단건 조회 (목록 조회 불가)
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(projectDoc(request.resource.data.projectId)).data.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /projects/{pid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      allow update: if signedIn() && (
        // 팀원: 수정 가능 (만든 사람·초대 코드는 바꿀 수 없음)
        (request.auth.uid in resource.data.memberUids
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode)
        ||
        // 초대 코드로 합류: memberUids 에 자기 자신만 추가하고,
        // 같은 batch 로 만든 자기 팀원 문서의 joinCode 가 프로젝트 초대 코드와 같아야 함
        (!(request.auth.uid in resource.data.memberUids)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
          && getAfter(/databases/$(database)/documents/projects/$(pid)/members/$(request.auth.uid)).data.joinCode == resource.data.inviteCode)
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{memberId} {
        allow read: if isMember(pid);
        allow create: if isMemberAfter(pid);
        allow update, delete: if isMember(pid);
      }

      match /tasks/{taskId} {
        allow read: if isMember(pid);
        allow create: if isMemberAfter(pid);
        allow update, delete: if isMember(pid);
      }
    }
  }
}
